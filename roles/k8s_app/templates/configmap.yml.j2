apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ k8s_app_name }}-html
  namespace: {{ k8s_namespace }}
  labels:
    app: {{ k8s_app_name }}
{% for key, value in k8s_app_labels.items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
data:
  index.html: |
    <html>
      <body>
        <h1>{{ k8s_app_message }}</h1>
        <p>Project: {{ project_name }}</p>
        <p>Generated by: {{ lookup('ansible.builtin.env', 'USER') | default('ansible', true) }}@{{ ansible_facts['hostname'] }}</p>
      </body>
    </html>
