apiVersion: apps/v1
kind: {{ k8s_app_kind }}
metadata:
  name: {{ k8s_app_name }}
  namespace: {{ k8s_namespace }}
  labels:
    app: {{ k8s_app_name }}
{% for key, value in k8s_app_labels.items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
spec:
  replicas: {{ k8s_app_replicas }}
  selector:
    matchLabels:
      app: {{ k8s_app_name }}
{% if k8s_app_kind == 'StatefulSet' %}
  serviceName: {{ k8s_app_name }}-headless
{% endif %}
  template:
    metadata:
      labels:
        app: {{ k8s_app_name }}
{% for key, value in k8s_app_labels.items() %}
        {{ key }}: "{{ value }}"
{% endfor %}
      annotations:
        # Changes when the ConfigMap changes, so the pods are restarted with the new content
        checksum/html: "{{ k8s_app_config_checksum }}"
    spec:
      containers:
        - name: web
          image: {{ k8s_app_image }}
          ports:
            - containerPort: {{ k8s_app_port }}
          readinessProbe:
            httpGet:
              path: /
              port: {{ k8s_app_port }}
          volumeMounts:
            - name: html
              mountPath: /usr/share/nginx/html
      volumes:
        - name: html
          configMap:
            name: {{ k8s_app_name }}-html
